# No production secret belongs in source control.
AGRISHOCK_ENV=development
AGRISHOCK_CONFIG_PATH=config/app.yaml
DATA_GOV_IN_API_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Containerized applications use kafka:9092, not localhost.
ELASTICSEARCH_URL=http://localhost:9200
LOG_LEVEL=INFO
INGESTION_MAX_ATTEMPTS=3
INGESTION_INITIAL_BACKOFF_SECONDS=1
IMD_DISTRICT_OBJECT_ID=
MANDI_API_URL=
IMD_API_URL=
GDACS_API_URL=
DELTA_ROOT=data/local/delta
CHECKPOINT_ROOT=data/checkpoints
# Versioned reference-data inputs required for geographic association.
MARKET_DIMENSION_PATH=
DISTRICT_BOUNDARY_PATH=
# Required only for the generic shock-to-price association query.
SHOCK_LOOKAHEAD_DAYS=
# Signal policy: all contribution caps must sum to 100. Values are provisional
# until calibrated against a documented validation set.
SIGNAL_MAX_SHOCK_SEVERITY=20
SIGNAL_MAX_PRICE_DECLINE=30
SIGNAL_MAX_ROBUST_ABNORMALITY=20
SIGNAL_MAX_TEMPORAL_PROXIMITY=10
SIGNAL_MAX_CONTROL_DIFFERENCE=20
SIGNAL_LOOKAHEAD_DAYS=14
SIGNAL_HIGH_THRESHOLD=70
SIGNAL_MEDIUM_THRESHOLD=40
